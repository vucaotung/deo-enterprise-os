# Enterprise OS local runner — env template
#
# Copy to `.env.local-runner` next to start-local-runner.ps1 (or set in shell)
# before launching scripts/openclaw-claude-runner.js.
#
# The daemon polls the VPS API, claims agent_jobs whose runtime_type matches
# AGENT_RUNTIME_TYPE, and runs Claude Code CLI locally. It reports logs/status
# back via /api/agent-runner/*. No inbound port is opened on the local machine.

# --- VPS control plane ------------------------------------------------------
# Public API URL (no trailing slash). Override only if running against a
# staging deployment.
ENTERPRISE_OS_API_URL=https://api.enterpriseos.bond/api

# Shared service token. Must match AGENT_RUNNER_TOKEN (or
# ENTERPRISE_OS_MCP_TOKEN) on the VPS api process. Issued by the admin out of
# band; treat like an SSH key.
AGENT_RUNNER_TOKEN=

# --- Identity ---------------------------------------------------------------
# Runtime this daemon owns. Matches deo.agents.runtime_type and
# agent_jobs.runtime_type. Worker on the VPS is configured (via
# EXTERNAL_RUNNER_RUNTIMES) to skip this runtime so this daemon is the only
# claimant.
AGENT_RUNTIME_TYPE=claude-code

# Company scope. Required so the daemon only claims jobs belonging to the
# tenant that owns this Windows machine.
AGENT_COMPANY_ID=b1f6384d-4ac0-40f1-91b9-95b8cfeb0712

# Agent row in deo.agents this daemon impersonates. Optional — when set, the
# claim endpoint will only return jobs already pre-assigned to this agent_id
# AND the runner pulses /api/agents/$AGENT_ID/heartbeat so the webapp shows
# "online".
AGENT_ID=

# --- Local execution --------------------------------------------------------
# Filesystem root the daemon allows claude.exe to operate inside. Jobs that
# request a workdir outside this root are rejected with a path-traversal
# error (see resolveWorkdir() in scripts/openclaw-claude-runner.js).
CLAUDE_CODE_WORKDIR_ROOT=C:\Users\Admin\.openclaw\workspace\repos\deo-enterprise-os

# Path to the Claude Code CLI binary. On Windows this is usually
# C:\Users\<user>\.local\bin\claude.exe; on POSIX it's `claude`.
CLAUDE_CODE_COMMAND=C:\Users\Admin\.local\bin\claude.exe

# Hard ceiling for a single claude.exe run (ms). The daemon SIGTERMs at
# this deadline, then SIGKILLs 5s later.
CLAUDE_CODE_TIMEOUT_MS=600000

# --- Runner cadence ---------------------------------------------------------
# How often to call /agent-runner/claim. Lower values claim faster but burn
# more API calls when the queue is empty.
AGENT_RUNNER_POLL_MS=5000

# How often to pulse /api/agents/$AGENT_ID/heartbeat. Capped to >=15s by the
# runner regardless of value.
AGENT_RUNNER_HEARTBEAT_MS=60000
